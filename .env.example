FLASK_ENV=production
SECRET_KEY=generate-a-random-key-here

# 1C server connection
SERVER_HOST=127.0.0.1
SERVER_PORT=80
SERVER_DB=base_name

# Web Push (VAPID) — auto-generated by deploy.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# Optional: bind host and port for gunicorn
HOST=0.0.0.0
PORT=5000

# Background worker
BACKGROUND_CHECK_INTERVAL=600
BALANCE_STALE_THRESHOLD=600
ACTION_CHECK_INTERVAL=60

# Yandex.Disk — получить refresh_token: python scripts/get_yandex_token.py --dotenv
#YANDEX_CLIENT_ID=
#YANDEX_CLIENT_SECRET=
#YANDEX_REFRESH_TOKEN=

# FIAS (справочник адресов) — master-token; если не задан, используется старый захардкоженный
#FIAS_MASTER_TOKEN=

# TWA (Android Play Store) — используется, если в корне приложения нет файла assetlinks.json
# TWA_PACKAGE_NAME=ru.mrcheck.app
# TWA_CERT_FINGERPRINT=AA:BB:CC:... (SHA-256 отпечаток ключа подписи, keytool -list)
