FLASK_ENV=production
SECRET_KEY=generate-a-random-key-here

# 1C server connection
SERVER_HOST=127.0.0.1
SERVER_PORT=80
SERVER_DB=base_name

# Web Push (VAPID) — auto-generated by deploy.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# Optional: bind host and port for gunicorn
HOST=0.0.0.0
PORT=5000

# Background worker
BACKGROUND_CHECK_INTERVAL=600
BALANCE_STALE_THRESHOLD=600

# Yandex OAuth (Android app)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_AUTH_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_REDIRECT_URI=https://oauth.yandex.ru/verification_code
YANDEX_DISK_API=https://cloud-api.yandex.net/v1/disk/resources
